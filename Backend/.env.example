# Render supplies PORT automatically. Use HOST=0.0.0.0 on Render.
PORT=5000
HOST=127.0.0.1
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
PASSWORD_RESET_URL=http://localhost:5173/reset-password
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_PUBLIC_SUPABASE_KEY
RECOVERY_STORAGE_SECRET=GENERATE_A_RANDOM_SERVER_ONLY_SECRET
RECOVERY_ENCRYPTION_KEY=GENERATE_32_RANDOM_BYTES_AS_BASE64
RECOVERY_STORAGE_ENABLED=false
# AI Smart Recommendations (Gemini). Server-only: never expose to Frontend/.
# GEMINI_API_KEY=PASTE_KEY_IN_BACKEND_ENV_ONLY
# AI_MODEL=gemini-3.5-flash-lite
# AI_FALLBACK_MODEL=gemini-flash-lite-latest
# AI_RECOMMENDATIONS_ENABLED=true
# Use Secure cookies automatically with NODE_ENV=production; local HTTP uses false.
COOKIE_SECURE=false
